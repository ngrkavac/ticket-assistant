{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions updates (SHA pin plus version comment).",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major updates per ecosystem to keep the PR count low.",
      "matchManagers": ["maven", "maven-wrapper"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Maven non-major"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python non-major"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust non-major"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose", "helm-values", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker images non-major"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool images that workflows run with docker run (helm.yml): an env var after a '# renovate: docker' comment, pinned as image:tag@digest.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: docker\\s+[A-Z_]+:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
