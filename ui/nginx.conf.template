# Runs behind oauth2-proxy (K2): browser -> oauth2-proxy (session cookie) -> this nginx -> assistant.
# oauth2-proxy passes the user's access token in X-Forwarded-Access-Token (--pass-access-token);
# nginx forwards it to the assistant as "Authorization: Bearer <token>". oauth2-proxy strips these
# headers from incoming requests, so this server must only be reachable through oauth2-proxy.
map $http_x_forwarded_access_token $assistant_authorization {
    ""      "";
    default "Bearer $http_x_forwarded_access_token";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # API calls go to the assistant, which validates the token (401 without one).
    location ~ ^/(ask|requests|customers|questions)$ {
        proxy_pass ${ASSISTANT_URL};
        # Always overwritten: never pass on an Authorization header sent by the browser.
        # An empty value makes nginx drop the header.
        proxy_set_header Authorization $assistant_authorization;
        proxy_set_header X-Forwarded-Access-Token "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header X-Forwarded-Preferred-Username "";
        proxy_set_header X-Forwarded-Groups "";
        proxy_set_header Cookie "";
        proxy_set_header X-API-Key "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Answers from the local model can take a minute or more. oauth2-proxy in front waits
        # slightly longer (OAUTH2_PROXY_UPSTREAM_TIMEOUT in docker-compose.yml), so nginx times out first.
        proxy_read_timeout 180s;
        client_max_body_size 64k;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build assets can be cached forever; index.html must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
