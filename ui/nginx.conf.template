server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # API calls go to the assistant; the API key is added here, never sent to the browser.
    location ~ ^/(ask|requests)$ {
        proxy_pass ${ASSISTANT_URL};
        proxy_set_header X-API-Key "${HELPDESK_API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Answers from the local model can take a minute or more.
        proxy_read_timeout 180s;
        client_max_body_size 64k;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build assets can be cached forever; index.html must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
